# ==============================================================================
# GCS2 - Variáveis de Ambiente e Configuração de Produção Cloudflare
# NUNCA envie seus tokens reais ou senhas para o GitHub.
# Use este arquivo como modelo para suas variáveis locais e GitHub Secrets.
# ==============================================================================

# 🔑 Segredo JWT para Assinatura de Tokens (Obrigatório em Produção)
# Defina na Cloudflare com: npx wrangler secret put JWT_SECRET
JWT_SECRET=sua-chave-secreta-jwt-super-segura-2026

# ☁️ Credenciais da Conta Cloudflare (Para GitHub Actions CI/CD e CLI)
CLOUDFLARE_ACCOUNT_ID=seu_account_id_cloudflare
CLOUDFLARE_API_TOKEN=seu_api_token_cloudflare_com_permissao_workers_d1_r2

# 🗄️ Cloudflare D1 (Banco de Dados Serverless)
# Criado com: npx wrangler d1 create gcs2-db
CLOUDFLARE_D1_DATABASE_NAME=gcs2-db
CLOUDFLARE_D1_DATABASE_ID=coloque-aqui-o-database-id-gerado-no-wrangler-d1-create

# 📦 Cloudflare R2 (Armazenamento de Fotos, Comprovantes e PDFs)
# Criado com: npx wrangler r2 bucket create gcs2-storage
CLOUDFLARE_R2_BUCKET_NAME=gcs2-storage

# 🌐 Ambiente (development / production)
ENVIRONMENT=production
